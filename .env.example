# 复制为 .env（不入库）后修改。供 docker compose 使用。

# 知识库根目录（宿主机路径，只读挂载进容器的 /vault）
WIKI_VAULT=D:/notes/my-vault

# MCP 端口发布方式，默认所有网卡的 8765；只想绑定某个网卡可写成 10.0.0.5:8765
# WIKI_MCP_PUBLISH=8765

# 使用已发布的镜像（不本地构建），之后 docker compose pull && docker compose up -d
# WIKI_MCP_IMAGE=ghcr.io/kevinliu623/wiki-mcp:0.2.0

# 时区（访问日志和 wiki_recent 的时间）
# TZ=Asia/Shanghai
